  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('service is healthy', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.status).to.eql('healthy');",
              "  pm.expect(json.service).to.eql('shipping-service');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness check. Returns { status, service, timestamp }."
      },
      "response": []
    },
    {
      "name": "Parse Labels -> CSV (single PDF)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('content-type is CSV', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",

        "url": {
          "raw": "{{baseUrl}}/api/shipping/parse-labels-csv",
          "host": ["{{baseUrl}}"],
          "path": ["api", "shipping", "parse-labels-csv"]
        },
        "description": "Uploads one PDF, splits it into per-label chunks, OCR fallback when extraction is weak, persists rows, and returns a CSV download (Full Name, Postal Code, Tracking Number)."
      },
      "response": []
